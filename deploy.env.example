# Where this deployment lives. Copy to the path in DEPLOY_CONFIG (default
# /etc/salto-mcp/telegram-deploy.env), fill in, keep out of version control.
#
# Nothing here is secret — it is a description of one machine, and one machine's
# layout does not belong in a public repository.

# Checkout the updater deploys from.
APP_DIR=/opt/telegram-mcp

# Compose project holding the per-account services.
SERVICE_DIR=/opt/telegram-service

# Container name prefix: with "tg-" the accounts below are tg-personal, tg-work.
CONTAINER_PREFIX=tg-

# Branch CI promotes verified commits onto. Deploying anything else defeats the
# point: the branch is the statement "these checks passed on this exact commit".
DEPLOY_BRANCH=release

# Accounts, restarted one after the other so a bad commit cannot take both down.
DEPLOY_ACCOUNTS="personal work"

# Health-check port per account.
DEPLOY_PORTS="personal=8000 work=8001"
