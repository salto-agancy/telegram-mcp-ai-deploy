# Non-secret deployment configuration. Copy to .env.
MCP_HOSTNAME=telegram-mcp.example.com
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_TUNNEL_NAME=telegram-mcp

# Container images may be replaced with immutable digest references after validation.
PYTHON_IMAGE=python:3.13-alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
TELEGRAM_MCP_IMAGE=telegram-mcp:local

# Safe build defaults. scripts/init-secrets.sh replaces these with the invoking
# operator's UID/GID, or selects an unassigned pair when deployment runs as root.
APP_UID=10001
APP_GID=10001

# Default security posture.
ENABLE_RAW_MTPROTO=false
ATTACHMENT_TICKET_TTL_SECONDS=300
TELEGRAM_ACCESS_MODE=read-only
TELEGRAM_ALLOWED_CHATS=me

# OAuth callbacks for Claude web. Add exact callbacks for other OAuth clients.
MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Optional tuning.
LOG_LEVEL=INFO
MAX_ACTIVE_SESSIONS=3
MAX_IDLE_TIME=1800
MAX_FILE_SIZE_MB=50
BLOCK_PRIVATE_IPS=true
ALLOW_HTTP_URLS=false
DO_NOT_TRACK=1
